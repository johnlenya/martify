# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Auto-seed an empty local database. Leave false in production.
AUTO_SEED=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production PostgreSQL (Neon, Supabase, RDS, etc.). When omitted, Martify uses
# an embedded PostgreSQL-compatible database (PGlite) in .data/martify-pg.
# DATABASE_URL=postgres://user:password@host:5432/martify?sslmode=require
# DATABASE_SSL=false
# PGLITE_DIR=.data/martify-pg

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Reserved for future integrations
# ---------------------------------------------------------------------------
# These placeholders are deliberately not wired in this build. Checkout,
# uploads and notifications are simulated. Adding keys alone enables nothing.
#
# PAYMENTS_MODE=demo
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
